# Copy to .env.local and fill in from Supabase → Project Settings → API Keys / Data API.
# Both values are public by design (they ship to the browser); access is enforced by
# row level security in the database. Never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
